# Copy this file to .env.local. Development works without it; every value below is optional there.
# Production needs DATABASE_URL, BETTER_AUTH_URL, and BETTER_AUTH_SECRET.

# Empty: embedded PGlite in .data/pglite.
# Neon or Supabase: paste the Postgres connection string they show. On a serverless host such as
# Vercel, use the pooled connection (Supabase: "Transaction pooler", port 6543).
DATABASE_URL=

# The public address of the site.
BETTER_AUTH_URL=http://localhost:3000

# At least 32 characters. Generate one with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Fill in both to enable "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
