{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!.data",
      "!build",
      "!src/data/local/database/migrations",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/core/logging/logger.ts", "scripts/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      "includes": ["src/core/**", "!src/core/testing/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/domain/**",
                      "**/data/**",
                      "**/di/**",
                      "**/presentation/**",
                      "**/app/**"
                    ],
                    "message": "core depends on no other layer."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/data/**",
                      "**/di/**",
                      "**/presentation/**",
                      "**/app/**"
                    ],
                    "message": "domain depends only on core."
                  },
                  {
                    "group": [
                      "next",
                      "next/**",
                      "react",
                      "react/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "better-auth",
                      "better-auth/**"
                    ],
                    "message": "domain stays free of frameworks and libraries."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/data/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/di/**", "**/presentation/**", "**/app/**"],
                    "message": "data depends only on domain and core."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/presentation/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/data/**",
                      "**/domain/repository/**",
                      "**/app/**"
                    ],
                    "message": "presentation reaches data only through use cases from @/di/container."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/data/**", "**/domain/repository/**"],
                    "message": "Routes stay thin: render a feature from presentation/features."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
